@using System.Diagnostics
@using Humanizer
@inject IJSRuntime JSRuntime
@inject GameWatcher eft
@inject MapsService MapsService
@inject TaskStateService TaskStateService
@inject QuestLogStore QuestLogStore
@inject LocalizationService LocalizationService
@inject MessageLog MessageLog
@implements IDisposable

@* Lives in the layout so the Tarkov.dev page stays loaded (and connected) while other tabs are shown. *@
<div class="map-host @(Visible ? "map-host--visible" : "map-host--hidden")" aria-hidden="@(!Visible)">
    <div class="map-host__toolbar">
        <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Class="map-host__icon" />
        @* Keyed on the map count so the select is rebuilt once Tarkov.dev map data arrives. *@
        <MudSelect @key="TarkovDev.Maps.Count" T="string" Value="@SelectedMap" ValueChanged="OnMapSelected" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                   RelativeWidth="DropdownWidth.Adaptive" AnchorOrigin="Origin.BottomLeft" PopoverFixed="false" Modal="false" MaxHeight="320"
                   Class="tm-select map-host__select" PopoverClass="tm-select-popover" ListClass="tm-select-list">
            @foreach (var map in MapChoices)
            {
                <MudSelectItem T="string" Value="@map.normalizedName">@map.name</MudSelectItem>
            }
        </MudSelect>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="map-host__status">@LocalizationService.GetString("MapSessionId"): @MapsService.SessionId</MudText>
        @* Replaces the gear of the hidden Tarkov.dev header: opens the site settings (language etc.) inside the frame. *@
        <MudIconButton Icon="@(MapsService.SettingsOpen ? Icons.Material.Filled.Map : Icons.Material.Filled.Settings)" Size="Size.Small" Color="@(MapsService.SettingsOpen ? Color.Info : Color.Inherit)" Disabled="@(!MapsService.FrameLoaded)"
                       Title="@LocalizationService.GetString(MapsService.SettingsOpen ? "BackToMap" : "TarkovDevSettings")" OnClick="ToggleSettings" />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Inherit" Title="@LocalizationService.GetString("ReloadMap")" OnClick="Reload" />
        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Inherit" Title="@LocalizationService.GetString("OpenMapInBrowser")" OnClick="OpenExternal" />
    </div>
    <div class="map-host__frame">
        @* Floating buttons in the corner where the site's settings gear used to be: markers, bosses, tasks. *@
        <button type="button" class="@("map-host__fab map-host__fab--markers" + (markersPanelOpen ? " map-host__fab--on" : ""))" title="@LocalizationService.GetString("MyMarkers")" @onclick="ToggleMarkersPanel">
            <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Medium" />
            @if (markers.Count > 0)
            {
                <span class="map-host__fab-count map-host__fab-count--markers">@markers.Count</span>
            }
        </button>
        @if (markersPanelOpen)
        {
            <div class="map-tasks map-bosses map-markers">
                <div class="map-tasks__header">
                    <span class="map-tasks__title"><MudText Typo="Typo.subtitle2">@string.Format(LocalizationService.GetString("MarkersOnMap"), MapsService.ShownMap?.name ?? MapsService.CurrentMapName)</MudText></span>
                    <span class="map-tasks__count map-tasks__count--markers">@markers.Count</span>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Inherit" OnClick="ToggleMarkersPanel" />
                </div>
                <div class="map-tasks__hint">@(placing ? LocalizationService.GetString("PlaceMarkerHint") : LocalizationService.GetString("MarkersHint"))</div>
                <div class="map-markers__actions">
                    <button type="button" class="@("map-markers__place" + (placing ? " map-markers__place--on" : ""))" @onclick="TogglePlacing">
                        <MudIcon Icon="@Icons.Material.Filled.AddLocation" Size="Size.Small" />
                        <span>@(placing ? LocalizationService.GetString("CancelPlacing") : LocalizationService.GetString("PlaceMarker"))</span>
                    </button>
                </div>
                <div class="map-tasks__list">
                    @if (markers.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="map-tasks__empty">@LocalizationService.GetString("NoMarkersYet")</MudText>
                    }
                    @foreach (var marker in markers)
                    {
                        <div class="map-task map-marker" @onclick="() => FocusMarker(marker)">
                            <div class="map-task__title">
                                <span class="map-task__name"><span class="map-marker__dot" style="@($"background: {marker.Color}")">@marker.Icon</span>@(string.IsNullOrEmpty(marker.Label) ? LocalizationService.GetString("UnnamedMarker") : marker.Label)</span>
                                <span class="map-marker__delete" title="@LocalizationService.GetString("DeleteMarker")" @onclick="() => DeleteMarker(marker)" @onclick:stopPropagation><MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" /></span>
                            </div>
                            @if (!string.IsNullOrEmpty(marker.Description))
                            {
                                <div class="map-task__objective"><span>@marker.Description</span></div>
                            }
                            <div class="map-marker__modes">@ModesLabel(marker)</div>
                        </div>
                    }
                </div>
            </div>
        }
        <button type="button" class="@("map-host__fab map-host__fab--bosses" + (bossesPanelOpen ? " map-host__fab--on" : ""))" title="@LocalizationService.GetString("ShowMapBosses")" @onclick="ToggleBossesPanel">
            <MudIcon Icon="@RifleIcon" Size="Size.Medium" />
        </button>
        @if (bossesPanelOpen)
        {
            <div class="map-tasks map-bosses">
                <div class="map-tasks__header">
                    <span class="map-tasks__title"><MudText Typo="Typo.subtitle2">@string.Format(LocalizationService.GetString("BossesOnMap"), MapsService.ShownMap?.name ?? MapsService.CurrentMapName)</MudText></span>
                    <span class="map-tasks__count map-tasks__count--bosses">@MapBosses.Count</span>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Inherit" OnClick="ToggleBossesPanel" />
                </div>
                <div class="map-tasks__hint">@LocalizationService.GetString("BossChanceHint")</div>
                <div class="map-tasks__list">
                    @if (MapBosses.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="map-tasks__empty">@LocalizationService.GetString("NoBossData")</MudText>
                    }
                    @foreach (var spawn in MapBosses)
                    {
                        <div class="map-task map-task--no-marker map-boss">
                            <div class="map-task__title">
                                <span class="map-task__name">@TarkovDev.MobName(spawn.mob)</span>
                                <span class="map-boss__chance">@FormatChance(spawn.spawnChance)</span>
                            </div>
                            @if (spawn.escorts.Count > 0)
                            {
                                <div class="map-task__objective"><span class="map-task__bullet">•</span><span>@string.Join(", ", spawn.escorts.Select(escort => TarkovDev.MobName(escort.mob)).Distinct())</span></div>
                            }
                            @foreach (var location in spawn.spawnLocations.OrderByDescending(location => location.chance).Take(4))
                            {
                                <div class="map-task__objective"><span class="map-task__bullet">◦</span><span>@LocationName(location.name)</span><span class="map-boss__location-chance">@FormatChance(location.chance)</span></div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        <button type="button" class="@("map-host__fab" + (tasksPanelOpen ? " map-host__fab--on" : ""))" title="@LocalizationService.GetString("ShowMapTasks")" @onclick="ToggleTasksPanel">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Medium" />
            @if (mapTasks.Count > 0)
            {
                <span class="map-host__fab-count">@mapTasks.Count</span>
            }
        </button>
        @if (tasksPanelOpen)
        {
            <div class="map-tasks">
                <div class="map-tasks__header">
                    <span class="map-tasks__title"><MudText Typo="Typo.subtitle2">@string.Format(LocalizationService.GetString("TasksOnMap"), MapsService.ShownMap?.name ?? MapsService.CurrentMapName)</MudText></span>
                    <span class="map-tasks__count">@mapTasks.Count</span>
                    @if (highlightedTaskId != null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.HighlightOff" Size="Size.Small" Color="Color.Warning" Title="@LocalizationService.GetString("ClearHighlight")" OnClick="ClearHighlight" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Inherit" OnClick="ToggleTasksPanel" />
                </div>
                <div class="map-tasks__hint">@LocalizationService.GetString("ClickTaskToLocate")</div>
                <div class="map-tasks__list">
                    @if (mapTasks.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="map-tasks__empty">@LocalizationService.GetString("NoTasksOnThisMap")</MudText>
                    }
                    @* Two blocks: what to take into a raid on this map, and what to look for in it.
                       Each folds (remembered) and can be switched off in the settings. *@
                    @foreach (var block in NeedBlocks)
                    {
                        var blockEntries = raidNeeds.Where(entry => block.Kinds.Contains(entry.Need.Kind)).ToList();
                        @if (blockEntries.Count > 0 && Setting(block.ShowSetting))
                        {
                            var open = !Setting(block.CollapsedSetting);
                            <div class="map-needs">
                                <button type="button" class="map-needs__head" @onclick="() => ToggleNeedBlock(block)">
                                    <MudIcon Icon="@block.Icon" Class="map-needs__head-icon" />
                                    <span class="map-needs__title">@LocalizationService.GetString(block.Title)</span>
                                    <span class="map-tasks__count">@blockEntries.Count</span>
                                    <MudIcon Icon="@(open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="map-needs__chevron" />
                                </button>
                                @if (open)
                                {
                                    @foreach (var group in block.Kinds)
                                    {
                                        var entries = blockEntries.Where(entry => entry.Need.Kind == group).ToList();
                                        @if (entries.Count > 0)
                                        {
                                            @if (block.Kinds.Length > 1)
                                            {
                                                <div class="map-needs__section">@NeedSectionLabel(group)</div>
                                            }
                                            @foreach (var entry in entries)
                                            {
                                                @* Hover shows each item with its picture. *@
                                                <MudTooltip Inline="false" Placement="Placement.Left">
                                                    <TooltipContent>
                                                        @foreach (var option in entry.Need.Items)
                                                        {
                                                            <div class="tm-tip__item">
                                                                @if (!string.IsNullOrEmpty(option.iconLink))
                                                                {
                                                                    <img src="@option.iconLink" alt="" loading="lazy" />
                                                                }
                                                                <span>@option.name</span>
                                                            </div>
                                                        }
                                                        @if (entry.Need.FoundInRaid)
                                                        {
                                                            <div class="tm-tip__note">@LocalizationService.GetString("FoundInRaid")</div>
                                                        }
                                                    </TooltipContent>
                                                    <ChildContent>
                                                        <div class="map-need">
                                                            <MudIcon Icon="@QuestNeeds.Icon(entry.Need)" Class="@("map-need__kind map-need__kind--" + entry.Need.Kind.ToString().ToLowerInvariant())" />
                                                            <span class="map-need__text">
                                                                <span class="map-need__name">@QuestNeeds.Label(entry.Need, LocalizationService.GetString)</span>
                                                                <small>@string.Join(", ", entry.Tasks)</small>
                                                            </span>
                                                            @if (entry.Need.Kind != QuestNeedKind.Key)
                                                            {
                                                                <span class="map-need__count">@(entry.Remaining)×</span>
                                                            }
                                                            @if (entry.Need.FoundInRaid)
                                                            {
                                                                <span class="map-need__fir">FIR</span>
                                                            }
                                                        </div>
                                                    </ChildContent>
                                                </MudTooltip>
                                            }
                                        }
                                    }
                                }
                            </div>
                        }
                    }
                    @foreach (var view in mapTasks)
                    {
                        @* Sections: pinned tasks first, then this map, then tasks that can be done anywhere. *@
                        var index = mapTasks.IndexOf(view);
                        @if (view.Pinned && index == 0)
                        {
                            <div class="map-tasks__section map-tasks__section--pinned map-tasks__section--first">@LocalizationService.GetString("PinnedTasks")</div>
                        }
                        else if (!view.Pinned && view.Maps.Count > 0 && index == mapTasks.FindIndex(candidate => !candidate.Pinned && candidate.Maps.Count > 0) && mapTasks.Any(candidate => candidate.Pinned))
                        {
                            <div class="map-tasks__section">@LocalizationService.GetString("ThisMap")</div>
                        }
                        else if (!view.Pinned && view.Maps.Count == 0 && index == mapTasks.FindIndex(candidate => !candidate.Pinned && candidate.Maps.Count == 0))
                        {
                            <div class="map-tasks__section">@LocalizationService.GetString("AnyLocation")</div>
                        }
                        <div class="@("map-task" + (view.Pinned ? " map-task--pinned" : "") + (highlightedTaskId == view.Task.id ? " map-task--highlighted" : "") + (view.HasMarkerOnCurrentMap ? "" : " map-task--no-marker"))"
                             title="@(view.HasMarkerOnCurrentMap ? "" : LocalizationService.GetString("NoMarkerOnMap"))" @onclick="() => HighlightTask(view)">
                            <div class="map-task__title">
                                <span class="map-task__name">
                                    @if (view.HasMarkerOnCurrentMap)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Class="map-task__pin" />
                                    }
                                    @if (!string.IsNullOrEmpty(view.Task.wikiLink))
                                    {
                                        @* The title opens the wiki; the click must not select the row. *@
                                        <a class="map-task__link" href="@view.Task.wikiLink" title="@LocalizationService.GetString("OpenWiki")"
                                           @onclick="() => OpenUrl(view.Task.wikiLink)" @onclick:preventDefault @onclick:stopPropagation>@view.Task.name</a>
                                    }
                                    else
                                    {
                                        @view.Task.name
                                    }
                                </span>
                                <span class="map-task__side">
                                    <span class="map-task__trader">@view.TraderName</span>
                                    @* The pin must not select the row. *@
                                    <button type="button" class="@("map-task__pin-toggle" + (view.Pinned ? " map-task__pin-toggle--on" : ""))"
                                            title="@LocalizationService.GetString(view.Pinned ? "UnpinTask" : "PinTask")"
                                            @onclick="() => TaskStateService.SetPinned(view.Task.id, !view.Pinned)" @onclick:stopPropagation>
                                        <MudIcon Icon="@(view.Pinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)" Style="font-size: 16px;" />
                                    </button>
                                </span>
                            </div>
                            @foreach (var objective in view.Task.objectives.Where(objective => IsOnCurrentMap(objective)))
                            {
                                <div class="map-task__objective">
                                    <span class="map-task__bullet">•</span>
                                    <span>@objective.description</span>
                                    @if (objective.optional)
                                    {
                                        <span class="map-task__optional">(@LocalizationService.GetString("Optional"))</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        @if (frameUrl != null)
        {
            <iframe id="@FrameElementId" @key="frameGeneration" src="@frameUrl" title="Tarkov.dev map" @onload="OnFrameLoaded" allow="clipboard-write" referrerpolicy="no-referrer"></iframe>
        }
        else
        {
            <div class="map-host__placeholder">
                <MudProgressCircular Indeterminate="true" Color="Color.Info" />
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public bool Visible { get; set; }

    private string? frameUrl;
    private int frameGeneration = -1;

    private string SelectedMap => MapsService.CurrentMapName;

    private IEnumerable<TarkovDev.Map> MapChoices
    {
        get
        {
            var maps = TarkovDev.Maps
                .Where(map => !string.IsNullOrEmpty(map.normalizedName))
                .GroupBy(map => map.normalizedName)
                .Select(group => group.First())
                .OrderBy(map => map.name)
                .ToList();
            if (!maps.Any(map => map.normalizedName == SelectedMap))
            {
                // Map data has not been retrieved yet; still show the default entry.
                maps.Add(new TarkovDev.Map { normalizedName = SelectedMap, name = SelectedMap });
            }
            return maps;
        }
    }

    // Tasks that can be worked on the map currently shown; the panel opens by
    // itself when a raid loads and can be toggled from the toolbar.
    private List<TaskView> mapTasks = new();
    private bool tasksPanelOpen;

    // Keys and items for the accepted tasks on this map; open objectives only, remaining counts.
    private sealed record RaidNeed(QuestNeed Need, int Remaining, List<string> Tasks);
    private List<RaidNeed> raidNeeds = new();
    // The two blocks of the panel; open or folded is remembered, each can be switched off in the settings.
    private sealed record NeedBlock(string Title, string Icon, QuestNeedKind[] Kinds, string ShowSetting, string CollapsedSetting);
    private static readonly NeedBlock[] NeedBlocks =
    {
        new("BringIntoRaid", Icons.Material.Filled.Luggage, new[] { QuestNeedKind.Key, QuestNeedKind.Place, QuestNeedKind.Mark }, nameof(Properties.Settings.Default.mapShowTakeAlong), nameof(Properties.Settings.Default.mapTakeAlongCollapsed)),
        new("NeedFindInRaid", Icons.Material.Filled.Search, new[] { QuestNeedKind.HandOver }, nameof(Properties.Settings.Default.mapShowFindInRaid), nameof(Properties.Settings.Default.mapFindInRaidCollapsed)),
    };

    private static bool Setting(string name) => Properties.Settings.Default[name] is true;

    private void ToggleNeedBlock(NeedBlock block)
    {
        Properties.Settings.Default[block.CollapsedSetting] = !Setting(block.CollapsedSetting);
        Properties.Settings.Default.Save();
    }

    private void OnSettingChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (NeedBlocks.Any(block => block.ShowSetting == e.PropertyName || block.CollapsedSetting == e.PropertyName))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private string NeedSectionLabel(QuestNeedKind kind) => kind switch
    {
        QuestNeedKind.Key => LocalizationService.GetString("NeedKeys"),
        QuestNeedKind.Place => LocalizationService.GetString("NeedPlace"),
        QuestNeedKind.Mark => LocalizationService.GetString("NeedMark"),
        _ => LocalizationService.GetString("NeedFindInRaid"),
    };

    private List<RaidNeed> CollectRaidNeeds()
    {
        var result = new List<RaidNeed>();
        var mapId = MapsService.ShownMap?.id;
        if (mapId == null)
        {
            return result;
        }
        void Add(QuestNeed need, int remaining, string taskName)
        {
            // The same item (or key) is listed once: keys count once, items add up their amounts.
            var ids = need.Items.Select(item => item.id).OrderBy(id => id).ToList();
            var index = result.FindIndex(entry => entry.Need.Kind == need.Kind
                && entry.Need.FoundInRaid == need.FoundInRaid
                && entry.Need.Items.Select(item => item.id).OrderBy(id => id).SequenceEqual(ids));
            if (index < 0)
            {
                result.Add(new RaidNeed(need, remaining, new List<string> { taskName }));
                return;
            }
            var known = result[index];
            if (!known.Tasks.Contains(taskName))
            {
                known.Tasks.Add(taskName);
            }
            if (need.Kind != QuestNeedKind.Key)
            {
                result[index] = known with { Remaining = known.Remaining + remaining };
            }
        }
        foreach (var view in mapTasks)
        {
            foreach (var objective in view.Task.objectives)
            {
                if (objective.maps.Count > 0 && !objective.maps.Contains(mapId))
                {
                    continue;
                }
                var progress = TaskStateService.GetObjectiveProgress(objective.id);
                if (progress.Complete)
                {
                    continue;
                }
                foreach (var need in QuestNeeds.Of(objective))
                {
                    // Hand-overs only matter in raid when the items must be found there.
                    if (need.Kind == QuestNeedKind.Build || (need.Kind == QuestNeedKind.HandOver && !need.FoundInRaid))
                    {
                        continue;
                    }
                    var remaining = need.Kind == QuestNeedKind.Key ? 1 : Math.Max(0, need.Count - progress.Count);
                    if (remaining > 0)
                    {
                        Add(need, remaining, view.Task.name);
                    }
                }
            }
            if (!QuestNeeds.ObjectivesListKeys(view.Task))
            {
                foreach (var key in QuestNeeds.TaskKeys(view.Task, mapId))
                {
                    Add(new QuestNeed(QuestNeedKind.Key, new List<TarkovDev.Item> { key }, 1, false), 1, view.Task.name);
                }
            }
        }
        return result;
    }
    private bool raidWasActive;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        MapsService.Changed += OnMapsChanged;
        LocalizationService.LanguageChanged += OnLanguageChanged;
        TarkovDev.ApiDataLoaded += OnApiDataLoaded;
        QuestLogStore.Changed += OnQuestDataChanged;
        TarkovTracker.ProgressRetrieved += OnProgressRetrieved;
        TarkovTracker.ProgressChanged += OnQuestDataChanged;
        TarkovTracker.ObjectiveProgressChanged += OnQuestDataChanged;
        Properties.Settings.Default.PropertyChanged += OnSettingChanged;
        MapsService.PositionUpdated += OnPositionUpdated;
        MapsService.HighlightRequested += OnHighlightRequested;
        eft.GameStarted += OnQuestDataChanged;
        eft.GameStopped += OnQuestDataChanged;
        eft.ProfileChanged += OnProfileChanged;
        SyncFrame();
        RefreshMapTasks();
    }

    // The Tasks tab asked to point at a task: open the panel and run the marker
    // search once the frame is there (it may still be loading).
    private void OnHighlightRequested(object? sender, TaskView view)
    {
        _ = InvokeAsync(async () =>
        {
            tasksPanelOpen = true;
            bossesPanelOpen = false;
            CloseFramePanels();
            highlightedTaskId = view.Task.id;
            StateHasChanged();
            for (var attempt = 0; attempt < 20 && !MapsService.FrameLoaded; attempt++)
            {
                await Task.Delay(500);
            }
            // The page may still be switching maps or reloading; the search is
            // idempotent inside the page, so send it a few times while the
            // highlight is still wanted.
            foreach (var delay in new[] { 1500, 2500, 3000, 4000, 5000 })
            {
                await Task.Delay(delay);
                if (highlightedTaskId != view.Task.id)
                {
                    return;
                }
                await SendSearch(view.Task.name);
            }
        });
    }

    // A screenshot moved the player marker: let it pulse for a few seconds so
    // the new position is easy to spot.
    private void OnPositionUpdated(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("mapHost.pulsePosition", FrameElementId, 5000);
            }
            catch (Exception exception)
            {
                MessageLog.Diagnostics.Capture(
                    new DiagnosticContext("TM-MAPS-006", "PulsePosition", "Maps", "Frame", "The position marker could not be highlighted."),
                    exception);
            }
        });
    }

    private void OnApiDataLoaded(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            RefreshMapTasks();
            StateHasChanged();
        });
    }

    private void OnQuestDataChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            RefreshMapTasks();
            StateHasChanged();
        });
    }

    private void OnProgressRetrieved(object? sender, TarkovTracker.ProgressRetrievedEventArgs e)
    {
        OnQuestDataChanged(sender, EventArgs.Empty);
    }

    private void RefreshMapTasks()
    {
        // Task data once a mode is known, from the game or remembered while it is closed.
        var sessionReady = GameWatcher.CurrentProfile.Snapshot() is { HasIdentity: true } profile && profile.SessionMode != EftSessionMode.Unknown;
        try
        {
            // Pinned tasks first (only those for this map or any location), then tasks bound
            // to this map, then tasks that can be done anywhere.
            mapTasks = !sessionReady ? new List<TaskView>() : TaskStateService.GetTasks()
                .Where(view => view.State == TaskState.Accepted && view.OnCurrentMap)
                .OrderByDescending(view => view.Pinned)
                .ThenBy(view => view.Pinned ? view.PinnedAt : DateTime.MaxValue)
                .ThenBy(view => view.Maps.Count == 0 ? 1 : 0)
                .ThenBy(view => view.TraderName)
                .ThenBy(view => view.Task.name)
                .ToList();
        }
        catch
        {
            mapTasks = new List<TaskView>();
        }
        try
        {
            raidNeeds = CollectRaidNeeds();
        }
        catch
        {
            raidNeeds = new List<RaidNeed>();
        }
        if (MapsService.RaidActive && !raidWasActive)
        {
            tasksPanelOpen = true;
        }
        raidWasActive = MapsService.RaidActive;
    }

    private bool IsOnCurrentMap(TarkovDev.TaskObjective objective)
    {
        var currentMapId = MapsService.ShownMap?.id;
        return objective.maps.Count == 0 || (currentMapId != null && objective.maps.Contains(currentMapId));
    }

    private void ToggleTasksPanel()
    {
        tasksPanelOpen = !tasksPanelOpen;
        if (tasksPanelOpen)
        {
            bossesPanelOpen = false;
            markersPanelOpen = false;
            CloseFramePanels();
        }
    }

    // ---- own markers: stored per map in the local database, drawn by the page ----
    private bool markersPanelOpen;
    private bool placing;
    private List<MapMarker> markers = new();
    private string markersMap = "";

    private void ToggleMarkersPanel()
    {
        markersPanelOpen = !markersPanelOpen;
        if (markersPanelOpen)
        {
            tasksPanelOpen = false;
            bossesPanelOpen = false;
            CloseFramePanels();
            LoadMarkers();
        }
        else if (placing)
        {
            placing = false;
            _ = JSRuntime.InvokeVoidAsync("mapHost.setPlacing", FrameElementId, false).AsTask();
        }
    }

    private void TogglePlacing()
    {
        placing = !placing;
        _ = JSRuntime.InvokeVoidAsync("mapHost.setPlacing", FrameElementId, placing).AsTask();
    }

    private void LoadMarkers()
    {
        markersMap = MapsService.CurrentMapName;
        try
        {
            var mode = HistoryStart.CurrentMode;
            markers = Stats.GetMarkers(markersMap).Where(marker => marker.ShownIn(mode)).ToList();
        }
        catch
        {
            markers = new List<MapMarker>();
        }
    }

    private async Task SendMarkers(string map)
    {
        List<MapMarker> list;
        try
        {
            list = Stats.GetMarkers(map);
        }
        catch
        {
            list = new List<MapMarker>();
        }
        var mode = HistoryStart.CurrentMode;
        var payload = list.Where(marker => marker.ShownIn(mode))
            .Select(marker => new { id = marker.Id, map = marker.Map, lat = marker.Lat, lng = marker.Lng, label = marker.Label, description = marker.Description, icon = marker.Icon, color = marker.Color, modes = marker.Modes.Split(',', StringSplitOptions.RemoveEmptyEntries) })
            .ToList();
        try
        {
            await JSRuntime.InvokeVoidAsync("mapHost.setMarkers", FrameElementId, payload);
        }
        catch
        {
            // Frame not reachable yet; the page asks again when its map is ready.
        }
    }

    private static string ModesLabel(MapMarker marker)
    {
        var modes = marker.Modes.Split(',', StringSplitOptions.RemoveEmptyEntries);
        if (modes.Length == 0 || modes.Length >= 3)
        {
            return "PVE · PVP · PVP Season";
        }
        return string.Join(" · ", modes.Select(mode => mode switch { "Regular" => "PVP", "Seasonal" => "PVP Season", _ => mode }));
    }

    private void FocusMarker(MapMarker marker)
    {
        _ = JSRuntime.InvokeVoidAsync("mapHost.focusMarker", FrameElementId, marker.Id).AsTask();
    }

    private async Task DeleteMarker(MapMarker marker)
    {
        Stats.DeleteMarker(marker.Id);
        LoadMarkers();
        await SendMarkers(markersMap);
    }

    [JSInvokable]
    public async Task OnFrameMapReady(string map)
    {
        placing = false;
        await SendMarkers(string.IsNullOrEmpty(map) ? MapsService.CurrentMapName : map);
        await InvokeAsync(() =>
        {
            if (markersPanelOpen)
            {
                LoadMarkers();
            }
            StateHasChanged();
        });
    }

    [JSInvokable]
    public void OnFramePlaced()
    {
        placing = false;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnFrameMarker(string action, string json)
    {
        try
        {
            var data = System.Text.Json.JsonDocument.Parse(json).RootElement;
            var id = data.GetProperty("id").GetString() ?? "";
            if (string.IsNullOrEmpty(id))
            {
                return;
            }
            if (action == "delete")
            {
                Stats.DeleteMarker(id);
            }
            else
            {
                var modes = data.TryGetProperty("modes", out var modesElement) && modesElement.ValueKind == System.Text.Json.JsonValueKind.Array
                    ? string.Join(",", modesElement.EnumerateArray().Select(item => item.GetString()).Where(item => !string.IsNullOrEmpty(item)))
                    : "";
                Stats.SaveMarker(new MapMarker(
                    id,
                    data.TryGetProperty("map", out var map) ? map.GetString() ?? MapsService.CurrentMapName : MapsService.CurrentMapName,
                    data.GetProperty("lat").GetDouble(),
                    data.GetProperty("lng").GetDouble(),
                    data.TryGetProperty("label", out var label) ? label.GetString() ?? "" : "",
                    data.TryGetProperty("description", out var description) ? description.GetString() ?? "" : "",
                    data.TryGetProperty("icon", out var icon) ? icon.GetString() ?? "" : "",
                    data.TryGetProperty("color", out var color) ? color.GetString() ?? "#e53935" : "#e53935",
                    modes));
            }
        }
        catch
        {
            return;
        }
        _ = InvokeAsync(() =>
        {
            LoadMarkers();
            StateHasChanged();
        });
    }
    // One panel at a time across both sides: opening ours closes the page's, and vice versa.
    private DotNetObjectReference<MapHost>? selfReference;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            selfReference = DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("mapHost.register", selfReference);
            }
            catch
            {
                // The script is not available yet; the panels then simply do not close each other.
            }
        }
    }
    private void CloseFramePanels()
    {
        _ = JSRuntime.InvokeVoidAsync("mapHost.closePanels", FrameElementId).AsTask();
    }
    [JSInvokable]
    public void OnFramePanelOpened()
    {
        if (!tasksPanelOpen && !bossesPanelOpen && !markersPanelOpen)
        {
            return;
        }
        markersPanelOpen = false;
        tasksPanelOpen = false;
        bossesPanelOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }
    // Rifle silhouette for the bosses button (the Material set has no weapon icon).
    private const string RifleIcon = "<path d=\"M1 9.5 6 9v4l-5 1zM6 9h9v4H6zM15 10h8v1.5h-8zM16 8.5h1.5V10H16zM9 13h3l2 6-2.5.5zM7 13h2l-.5 4H6.5z\"/>";
    // Boss spawns of the shown map (from the Tarkov.dev map data), highest chance first.
    private bool bossesPanelOpen;
    private List<TarkovDev.BossSpawn> MapBosses => (MapsService.ShownMap?.bosses ?? new List<TarkovDev.BossSpawn>())
        .Where(spawn => !string.IsNullOrEmpty(spawn.mob) && !spawn.mob.StartsWith("pmc", StringComparison.OrdinalIgnoreCase))
        .GroupBy(spawn => spawn.mob)
        .Select(group => group.OrderByDescending(spawn => spawn.spawnChance).First())
        .OrderByDescending(spawn => spawn.spawnChance)
        .ThenBy(spawn => TarkovDev.MobName(spawn.mob))
        .ToList();
    private void ToggleBossesPanel()
    {
        bossesPanelOpen = !bossesPanelOpen;
        if (bossesPanelOpen)
        {
            tasksPanelOpen = false;
            markersPanelOpen = false;
            CloseFramePanels();
        }
    }
    private static string FormatChance(double chance) => chance <= 0 ? "" : $"{Math.Round(chance * 100)} %";
    // Spawn zone ids read like "ZoneGasStation"; split them into words.
    private static string LocationName(string zone)
    {
        var name = zone.StartsWith("Zone", StringComparison.Ordinal) ? zone[4..] : zone;
        return System.Text.RegularExpressions.Regex.Replace(name, "(?<=[a-z0-9])(?=[A-Z])|_", " ");
    }

    private const string FrameElementId = "tarkov-map-frame";
    private string? highlightedTaskId;

    // Clicking a task runs the Tarkov.dev marker search inside the frame: the
    // task's markers pulse and all other markers are hidden. Clicking the
    // same task again clears it.
    private async Task HighlightTask(TaskView view)
    {
        if (!view.HasMarkerOnCurrentMap)
        {
            // Nothing to point at on this map; the entry is shown muted instead.
            return;
        }
        if (highlightedTaskId == view.Task.id)
        {
            await ClearHighlight();
            return;
        }
        highlightedTaskId = view.Task.id;
        await SendSearch(view.Task.name);
    }

    private async Task ClearHighlight()
    {
        highlightedTaskId = null;
        await SendSearch("");
    }

    private async Task SendSearch(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("mapHost.search", FrameElementId, text);
        }
        catch (Exception exception)
        {
            MessageLog.Diagnostics.Capture(
                new DiagnosticContext("TM-MAPS-005", "HighlightTask", "Maps", "Frame", "The task could not be highlighted on the map."),
                exception);
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Visible)
        {
            MapsService.RequestFrame();
            SyncFrame();
        }
    }

    // The iframe src is only (re)assigned when a full reload is wanted. Map
    // changes while the page is loaded are done through socket commands so
    // the Tarkov.dev page navigates internally without reloading.
    private void SyncFrame()
    {
        if (!MapsService.FrameRequested)
        {
            return;
        }
        if (frameUrl == null || frameGeneration != MapsService.FrameGeneration)
        {
            frameGeneration = MapsService.FrameGeneration;
            frameUrl = MapsService.FrameUrl;
            // A reload drops the marker search inside the page.
            highlightedTaskId = null;
        }
    }

    private void OnMapsChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            SyncFrame();
            RefreshMapTasks();
            StateHasChanged();
        });
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnFrameLoaded(ProgressEventArgs args)
    {
        var loaded = MapsService.FrameLoadedAsync();
        // The site may restore an earlier search; start with a clean map once it has rendered.
        await Task.Delay(TimeSpan.FromSeconds(3));
        await SendSearch("");
        await loaded;
    }

    private async Task OnMapSelected(string normalizedName)
    {
        if (string.IsNullOrEmpty(normalizedName) || normalizedName == SelectedMap)
        {
            return;
        }
        var map = TarkovDev.Maps.Find(candidate => candidate.normalizedName == normalizedName);
        if (map == null)
        {
            return;
        }
        await MapsService.NavigateAsync(map);
    }

    private Task ToggleSettings()
    {
        return MapsService.ToggleSettingsAsync();
    }

    private void Reload()
    {
        MapsService.ReloadFrame();
    }

    private void OpenExternal()
    {
        OpenUrl(MapsService.ExternalUrl);
    }

    private void OpenUrl(string? url)
    {
        if (string.IsNullOrEmpty(url))
        {
            return;
        }
        try
        {
            Process.Start(new ProcessStartInfo(url)
            {
                UseShellExecute = true,
            });
        }
        catch (Exception exception)
        {
            MessageLog.Diagnostics.Capture(
                new DiagnosticContext("TM-MAPS-002", "OpenInBrowser", "Maps", "Navigation", "The page could not be opened in the browser."),
                exception);
        }
    }

    public void Dispose()
    {
        MapsService.Changed -= OnMapsChanged;
        LocalizationService.LanguageChanged -= OnLanguageChanged;
        TarkovDev.ApiDataLoaded -= OnApiDataLoaded;
        QuestLogStore.Changed -= OnQuestDataChanged;
        TarkovTracker.ProgressRetrieved -= OnProgressRetrieved;
        TarkovTracker.ProgressChanged -= OnQuestDataChanged;
        TarkovTracker.ObjectiveProgressChanged -= OnQuestDataChanged;
        Properties.Settings.Default.PropertyChanged -= OnSettingChanged;
        MapsService.PositionUpdated -= OnPositionUpdated;
        MapsService.HighlightRequested -= OnHighlightRequested;
        eft.GameStarted -= OnQuestDataChanged;
        eft.GameStopped -= OnQuestDataChanged;
        eft.ProfileChanged -= OnProfileChanged;
        selfReference?.Dispose();
    }
    private void OnProfileChanged(object? sender, ProfileEventArgs e) => OnQuestDataChanged(sender, EventArgs.Empty);

@page "/tasks"
@using System.Diagnostics
@inject TaskStateService TaskStateService
@inject QuestLogStore QuestLogStore
@inject MapsService MapsService
@inject TimersManager TimersManager
@inject LocalizationService LocalizationService
@inject MessageLog MessageLog
@inject ISnackbar Snackbar
@layout AppLayout
@implements IDisposable

<div class="tasks-page">
    <MudPaper Class="app-surface tasks-head" Elevation="3">
        <div class="tasks-head__row">
            <MudText Typo="Typo.h6" Class="d-flex align-center tasks-head__title">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" />
                <span class="tm-card-heading-text">@LocalizationService.GetString("Tasks")</span>
            </MudText>
            <MudTextField T="string" Value="@search" ValueChanged="OnSearchChanged" Immediate="true" DebounceInterval="150"
                          Placeholder="@LocalizationService.GetString("SearchTasks")" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="tm-input tasks-search" />
            <div class="tasks-seg">
                @foreach (var option in ViewOptions)
                {
                    <button type="button" class="@("tasks-seg__btn" + (view == option ? " tasks-seg__btn--on" : ""))" @onclick="() => SetView(option)">
                        @ViewLabel(option)<span class="tasks-seg__count">@CountFor(option)</span>
                    </button>
                }
            </div>
            <MudSelect T="string" Value="@mapFilter" ValueChanged="OnMapFilterChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                       Label="@LocalizationService.GetString("Map")" RelativeWidth="DropdownWidth.Adaptive" AnchorOrigin="Origin.BottomLeft" PopoverFixed="false" Modal="false" MaxHeight="320"
                       Class="tm-select tasks-select" PopoverClass="tm-select-popover" ListClass="tm-select-list">
                <MudSelectItem T="string" Value="@string.Empty">@LocalizationService.GetString("AllMaps")</MudSelectItem>
                @foreach (var map in MapChoices)
                {
                    <MudSelectItem T="string" Value="@map.id">@map.name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="TaskSort" Value="@sort" ValueChanged="OnSortChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                       Label="@LocalizationService.GetString("SortBy")" RelativeWidth="DropdownWidth.Adaptive" AnchorOrigin="Origin.BottomLeft" PopoverFixed="false" Modal="false"
                       Class="tm-select tasks-select" PopoverClass="tm-select-popover" ListClass="tm-select-list">
                <MudSelectItem T="TaskSort" Value="TaskSort.Default">@LocalizationService.GetString("SortDefault")</MudSelectItem>
                <MudSelectItem T="TaskSort" Value="TaskSort.Name">@LocalizationService.GetString("SortName")</MudSelectItem>
                <MudSelectItem T="TaskSort" Value="TaskSort.Trader">@LocalizationService.GetString("SortTrader")</MudSelectItem>
                <MudSelectItem T="TaskSort" Value="TaskSort.Experience">@LocalizationService.GetString("SortExperience")</MudSelectItem>
                <MudSelectItem T="TaskSort" Value="TaskSort.Level">@LocalizationService.GetString("SortLevel")</MudSelectItem>
            </MudSelect>
        </div>
        <div class="tasks-stats">
            <span><b>@accepted.Count</b> @LocalizationService.GetString("StatAccepted")</span>
            @if (currentMap != null)
            {
                <span><b>@accepted.Count(item => item.OnCurrentMap)</b> @string.Format(LocalizationService.GetString("StatDoableOn"), currentMap.name)</span>
            }
            <span><b>@accepted.Count(item => item.Task.kappaRequired)</b> Kappa</span>
            <span><b>@accepted.Sum(item => item.Task.experience).ToString("N0")</b> @LocalizationService.GetString("StatOpenXp")</span>
        </div>
        <div class="tasks-traders">
            <button type="button" class="@("tasks-chip" + (traderFilter == null ? " tasks-chip--on" : ""))" @onclick="() => SetTrader(null)">@LocalizationService.GetString("AllTraders")</button>
            @foreach (var trader in TraderChoices)
            {
                <button type="button" class="@("tasks-chip" + (traderFilter == trader ? " tasks-chip--on" : ""))" @onclick="() => SetTrader(trader)">@trader</button>
            }
            <button type="button" class="@("tasks-chip tasks-chip--kappa" + (kappaOnly ? " tasks-chip--on" : ""))" @onclick="ToggleKappa">@LocalizationService.GetString("KappaOnly")</button>
        </div>
    </MudPaper>

    @if (!TaskStateService.HasTrackerProgress)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="tasks-alert">@LocalizationService.GetString("TasksNeedTracker")</MudAlert>
    }

    @if (view == TaskListView.Accepted && accepted.Count > 0)
    {
        <MudPaper Class="app-surface tasks-reco" Elevation="3">
            <div class="tasks-reco__head">
                <MudText Typo="Typo.subtitle1" Class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Recommend" Class="mr-2" Color="Color.Warning" />
                    <span>@LocalizationService.GetString("RecommendedTasks")</span>
                </MudText>
                <span class="tasks-reco__hint">@ModeHint(recommendationMode)</span>
                <div class="tasks-reco__modes">
                    @foreach (var mode in ModeOptions)
                    {
                        <button type="button" class="@("tasks-chip tasks-chip--mode" + (recommendationMode == mode ? " tasks-chip--on" : "") + (mode == RecommendationMode.CurrentMap ? " tasks-chip--current" : ""))" @onclick="() => SetMode(mode)">@ModeLabel(mode)</button>
                    }
                </div>
            </div>
            @if (recommendations.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="tasks-reco__empty">@LocalizationService.GetString("NoRecommendations")</MudText>
            }
            <div class="tasks-reco__cards">
                @foreach (var (item, index) in recommendations.Select((item, index) => (item, index)))
                {
                    <div class="@("reco-card" + (currentMap != null && item.View.OnCurrentMap ? " reco-card--current" : ""))">
                        <span class="reco-card__rank">@(index + 1)</span>
                        <div class="reco-card__title">@item.View.Task.name</div>
                        <div class="reco-card__trader">@item.View.TraderName</div>
                        <div class="tasks-maps">
                            @if (item.View.Maps.Count == 0)
                            {
                                <span class="task-map">@LocalizationService.GetString("AnyLocation")</span>
                            }
                            @foreach (var map in item.View.Maps)
                            {
                                <span class="@("task-map" + (currentMap != null && map.id == currentMap.id ? " task-map--current" : ""))">@map.name</span>
                            }
                            @if (item.View.Task.kappaRequired)
                            {
                                <span class="task-map task-map--kappa">Kappa</span>
                            }
                        </div>
                        <div class="reco-card__metric">@string.Format(LocalizationService.GetString("UnlocksTasks"), item.DirectUnlocks.Count, item.TotalUnlocks)</div>
                        <div class="reco-card__kv">
                            <span>XP <b>@item.Experience.ToString("N0")</b></span>
                            <span>@LocalizationService.GetString("Level") <b>@item.View.Task.minPlayerLevel</b></span>
                        </div>
                        @if (item.DirectUnlocks.Count > 0)
                        {
                            <div class="reco-card__next">→ @string.Join(", ", item.DirectUnlocks.Take(4).Select(task => task.name))@(item.DirectUnlocks.Count > 4 ? ", …" : "")</div>
                        }
                    </div>
                }
            </div>
        </MudPaper>
    }

    @if (visible.Count == 0)
    {
        <MudText Class="tasks-empty" Typo="Typo.body2">@LocalizationService.GetString("NoTasks")</MudText>
    }

    @foreach (var group in visible.GroupBy(item => currentMap != null && item.OnCurrentMap))
    {
        @if (currentMap != null)
        {
            <div class="@("tasks-group" + (group.Key ? " tasks-group--current" : ""))">
                @(group.Key ? string.Format(LocalizationService.GetString("TasksOnMap"), currentMap.name) : LocalizationService.GetString("TasksElsewhere"))
                <span class="tasks-group__count">@group.Count()</span>
            </div>
        }
        <div class="tasks-cols">
            <span></span>
            <span>@LocalizationService.GetString("ColumnTask")</span>
            <span>@LocalizationService.GetString("ColumnMaps")</span>
            <span class="tasks-cols__num">XP</span>
            <span class="tasks-cols__num">@LocalizationService.GetString("ColumnObjectives")</span>
            <span>@LocalizationService.GetString("ColumnStatus")</span>
            <span class="tasks-cols__actions">@LocalizationService.GetString("ColumnActions")</span>
        </div>
        @foreach (var item in group)
        {
            var isOpen = expanded.Contains(item.Task.id);
            <div class="@("task-row" + (currentMap != null && item.OnCurrentMap ? " task-row--current" : "") + (item.State is TaskState.Hidden or TaskState.NeverAccepted ? " task-row--muted" : ""))">
                <button type="button" class="task-row__toggle" @onclick="() => ToggleExpanded(item.Task.id)">
                    <MudIcon Icon="@(isOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                </button>
                <div class="task-row__title" @onclick="() => ToggleExpanded(item.Task.id)">
                    <div class="task-row__name">
                        @if (item.HasMarkerOnCurrentMap && currentMap != null)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Class="task-row__pin" />
                        }
                        @item.Task.name
                    </div>
                    <div class="task-row__sub">@item.TraderName@(item.AcceptedAt != null ? " · " + string.Format(LocalizationService.GetString("TaskAcceptedOn"), item.AcceptedAt.Value.ToString("d")) : "")</div>
                </div>
                <div class="tasks-maps">
                    @if (item.Maps.Count == 0)
                    {
                        <span class="task-map">@LocalizationService.GetString("AnyLocation")</span>
                    }
                    @foreach (var map in item.Maps)
                    {
                        <span class="@("task-map" + (currentMap != null && map.id == currentMap.id ? " task-map--current" : ""))">@map.name</span>
                    }
                    @if (item.Task.kappaRequired)
                    {
                        <span class="task-map task-map--kappa">Kappa</span>
                    }
                </div>
                <div class="task-row__xp">@(item.Task.experience > 0 ? item.Task.experience.ToString("N0") : "–")</div>
                <div class="task-row__objectives">
                    @{
                        var (done, total) = TaskStateService.ObjectiveSummary(item.Task);
                    }
                    @if (total > 0)
                    {
                        <span class="@(done == total ? "task-row__objectives--done" : "")">@done/@total</span>
                    }
                    else
                    {
                        <span>–</span>
                    }
                </div>
                <div><span class="@("task-status task-status--" + item.State.ToString().ToLowerInvariant())" title="@ReasonLabel(item)">@StateLabel(item.State)</span></div>
                <div class="task-row__actions">
                    <MudIconButton Icon="@Icons.Material.Filled.MyLocation" Size="Size.Small" Color="@(item.MarkerMapIds.Count > 0 ? Color.Inherit : Color.Default)"
                                   Disabled="@(item.MarkerMapIds.Count == 0)" Title="@LocalizationService.GetString("ShowOnMap")" OnClick="@(() => ShowOnMap(item))" />
                    @if (item.Override != QuestOverride.None)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Color="Color.Inherit" Title="@LocalizationService.GetString("ResetTaskOverride")" OnClick="@(() => SetOverride(item, QuestOverride.None))" />
                    }
                    else if (item.State == TaskState.Accepted)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small" Color="Color.Inherit" Title="@LocalizationService.GetString("HideTask")" OnClick="@(() => SetOverride(item, QuestOverride.Hidden))" />
                    }
                    else if (item.State != TaskState.Completed)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Small" Color="Color.Inherit" Title="@LocalizationService.GetString("MarkTaskAccepted")" OnClick="@(() => SetOverride(item, QuestOverride.Accepted))" />
                        @if (item.State != TaskState.Hidden)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small" Color="Color.Inherit" Title="@LocalizationService.GetString("HideTask")" OnClick="@(() => SetOverride(item, QuestOverride.Hidden))" />
                        }
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Inherit" Title="tarkov.dev" OnClick="@(() => OpenTask(item.Task))" />
                </div>
                @if (isOpen)
                {
                    <div class="task-row__details">
                        @if (!TaskStateService.CanWriteObjectives)
                        {
                            <div class="task-row__note">@LocalizationService.GetString("ObjectivesNeedToken")</div>
                        }
                        @foreach (var objective in item.Task.objectives)
                        {
                            var progress = TaskStateService.GetObjectiveProgress(objective.id);
                            var busy = busyObjectives.Contains(objective.id);
                            var ready = !progress.Complete && objective.count >= 1 && progress.Count >= objective.count;
                            var canWrite = !busy && TaskStateService.CanWriteObjectives;
                            <div class="@("task-objective" + (progress.Complete ? " task-objective--done" : "") + (ready ? " task-objective--ready" : ""))">
                                @* green check = handed over / completed, blue half mark = collected but not handed over *@
                                <button type="button" class="@("task-objective__check" + (progress.Complete ? " task-objective__check--done" : ready ? " task-objective__check--ready" : ""))"
                                        disabled="@(!canWrite)" title="@(progress.Complete ? LocalizationService.GetString("ObjectiveDone") : ready ? LocalizationService.GetString("ObjectiveReady") : "")"
                                        @onclick="() => SetObjectiveComplete(objective, !progress.Complete)">
                                    <MudIcon Icon="@(progress.Complete ? Icons.Material.Filled.CheckBox : ready ? Icons.Material.Filled.IndeterminateCheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" Size="Size.Small" />
                                </button>
                                <div class="task-objective__body">
                                    <span class="task-objective__text">@objective.description</span>
                                    @if (objective.optional)
                                    {
                                        <span class="task-objective__optional">(@LocalizationService.GetString("Optional"))</span>
                                    }
                                    @foreach (var mapId in objective.maps)
                                    {
                                        var map = TarkovDev.Maps.Find(candidate => candidate.id == mapId);
                                        if (map != null)
                                        {
                                            <span class="@("task-map" + (currentMap != null && map.id == currentMap.id ? " task-map--current" : ""))">@map.name</span>
                                        }
                                    }
                                </div>
                                <span class="task-objective__state">
                                    @if (progress.Complete)
                                    {
                                        <span class="task-objective__badge task-objective__badge--done">@LocalizationService.GetString("ObjectiveDone")</span>
                                    }
                                    else if (ready)
                                    {
                                        <span class="task-objective__badge task-objective__badge--ready">@LocalizationService.GetString("ObjectiveReady")</span>
                                    }
                                </span>
                                @if (objective.count >= 1)
                                {
                                    <span class="task-objective__counter" title="@LocalizationService.GetString("ObjectiveCountHint")">
                                        <button type="button" class="task-objective__step" disabled="@(!canWrite || progress.Count <= 0)" @onclick="() => ChangeObjectiveCount(objective, -1)">−</button>
                                        <span class="task-objective__count">@Math.Min(progress.Count, objective.count)<span class="task-objective__of">/@objective.count</span></span>
                                        <button type="button" class="task-objective__step" disabled="@(!canWrite || progress.Count >= objective.count)" @onclick="() => ChangeObjectiveCount(objective, 1)">+</button>
                                    </span>
                                }
                                else
                                {
                                    <span></span>
                                }
                            </div>
                        }
                        <div class="task-row__meta">
                            @if (UnlocksOf(item).Count > 0)
                            {
                                <span>@LocalizationService.GetString("Unlocks"): @string.Join(", ", UnlocksOf(item).Select(task => task.name))</span>
                            }
                            @if (item.Task.minPlayerLevel > 0)
                            {
                                <span>@LocalizationService.GetString("Level") @item.Task.minPlayerLevel</span>
                            }
                            @if (item.AcceptedReason != "")
                            {
                                <span>@ReasonLabel(item)</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [CascadingParameter(Name = "AppLayout")]
    public AppLayout AppLayout { get; set; } = default!;

    private enum TaskListView { Accepted, Available, Hidden, Completed }
    private enum TaskSort { Default, Name, Trader, Experience, Level }

    private static readonly TaskListView[] ViewOptions = { TaskListView.Accepted, TaskListView.Available, TaskListView.Hidden, TaskListView.Completed };

    private List<TaskView> all = new();
    private List<TaskView> accepted = new();
    private List<TaskView> visible = new();
    private List<TaskRecommendation> recommendations = new();
    private Dictionary<string, List<TarkovDev.Task>> dependents = new();
    private TarkovDev.Map? currentMap;
    private string search = "";
    private string mapFilter = "";
    private string? traderFilter;
    private bool kappaOnly;
    private TaskListView view = TaskListView.Accepted;
    private TaskSort sort = TaskSort.Default;
    private RecommendationMode recommendationMode = RecommendationMode.Unlocks;
    private readonly HashSet<string> expanded = new();

    private IEnumerable<RecommendationMode> ModeOptions
    {
        get
        {
            yield return RecommendationMode.Unlocks;
            yield return RecommendationMode.Experience;
            yield return RecommendationMode.Kappa;
            if (currentMap != null)
            {
                yield return RecommendationMode.CurrentMap;
            }
            yield return RecommendationMode.Mix;
        }
    }

    private IEnumerable<TarkovDev.Map> MapChoices => TarkovDev.Maps
        .Where(map => !string.IsNullOrEmpty(map.normalizedName))
        .GroupBy(map => map.normalizedName)
        .Select(group => group.First())
        .OrderBy(map => map.name);

    private IEnumerable<string> TraderChoices => all
        .Where(item => item.State == StateFor(view) || (view == TaskListView.Hidden && item.State is TaskState.Hidden or TaskState.NeverAccepted))
        .Select(item => item.TraderName)
        .Where(name => name != "")
        .Distinct()
        .OrderBy(name => name);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        QuestLogStore.Changed += OnDataChanged;
        MapsService.Changed += OnDataChanged;
        TimersManager.RaidActiveChanged += OnDataChanged;
        TarkovDev.ApiDataLoaded += OnDataChanged;
        TarkovTracker.ProgressRetrieved += OnProgressRetrieved;
        TarkovTracker.ObjectiveProgressChanged += OnObjectiveProgressChanged;
        LocalizationService.LanguageChanged += OnDataChanged;
        Refresh();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (firstRender)
        {
            AppLayout.SetTitle(LocalizationService.GetString("Tasks"));
        }
    }

    private void OnDataChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    private void OnProgressRetrieved(object? sender, TarkovTracker.ProgressRetrievedEventArgs e)
    {
        OnDataChanged(sender, EventArgs.Empty);
    }

    private void Refresh()
    {
        currentMap = MapsService.RaidActive || TimersManager.IsRaidActive ? MapsService.CurrentMap : null;
        if (currentMap == null && recommendationMode == RecommendationMode.CurrentMap)
        {
            recommendationMode = RecommendationMode.Unlocks;
        }
        all = TaskStateService.GetTasks();
        accepted = all.Where(item => item.State == TaskState.Accepted).ToList();
        recommendations = TaskStateService.GetRecommendations(all, 3, recommendationMode);
        dependents = new Dictionary<string, List<TarkovDev.Task>>();
        foreach (var task in TarkovDev.Tasks)
        {
            foreach (var requirement in task.taskRequirements)
            {
                if (string.IsNullOrEmpty(requirement.task) || !requirement.status.Contains("complete"))
                {
                    continue;
                }
                if (!dependents.TryGetValue(requirement.task, out var list))
                {
                    list = new List<TarkovDev.Task>();
                    dependents[requirement.task] = list;
                }
                list.Add(task);
            }
        }
        ApplyFilter();
    }

    private static TaskState StateFor(TaskListView option) => option switch
    {
        TaskListView.Available => TaskState.Available,
        TaskListView.Hidden => TaskState.Hidden,
        TaskListView.Completed => TaskState.Completed,
        _ => TaskState.Accepted,
    };

    private int CountFor(TaskListView option) => option == TaskListView.Hidden
        ? all.Count(item => item.State is TaskState.Hidden or TaskState.NeverAccepted)
        : all.Count(item => item.State == StateFor(option));

    private void ApplyFilter()
    {
        IEnumerable<TaskView> query = view == TaskListView.Hidden
            ? all.Where(item => item.State is TaskState.Hidden or TaskState.NeverAccepted)
            : all.Where(item => item.State == StateFor(view));
        if (traderFilter != null)
        {
            query = query.Where(item => item.TraderName == traderFilter);
        }
        if (kappaOnly)
        {
            query = query.Where(item => item.Task.kappaRequired);
        }
        if (!string.IsNullOrEmpty(mapFilter))
        {
            query = query.Where(item => item.Maps.Count == 0 || item.Maps.Any(map => map.id == mapFilter));
        }
        if (!string.IsNullOrWhiteSpace(search))
        {
            var term = search.Trim();
            query = query.Where(item =>
                item.Task.name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || item.TraderName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || item.Maps.Any(map => map.name.Contains(term, StringComparison.OrdinalIgnoreCase))
                || item.Task.objectives.Any(objective => (objective.description ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        var ordered = query.OrderByDescending(item => currentMap != null && item.OnCurrentMap)
            .ThenBy(item => currentMap != null && item.OnCurrentMap && item.Maps.Count == 0 ? 1 : 0);
        visible = (sort switch
        {
            TaskSort.Name => ordered.ThenBy(item => item.Task.name),
            TaskSort.Trader => ordered.ThenBy(item => item.TraderName).ThenBy(item => item.Task.name),
            TaskSort.Experience => ordered.ThenByDescending(item => item.Task.experience).ThenBy(item => item.Task.name),
            TaskSort.Level => ordered.ThenBy(item => item.Task.minPlayerLevel).ThenBy(item => item.Task.name),
            _ => ordered.ThenBy(item => item.TraderName).ThenBy(item => item.Task.name),
        }).ToList();
    }

    private List<TarkovDev.Task> UnlocksOf(TaskView item) => dependents.TryGetValue(item.Task.id, out var list) ? list : new List<TarkovDev.Task>();

    private void SetView(TaskListView option) { view = option; traderFilter = null; ApplyFilter(); }
    private void SetTrader(string? trader) { traderFilter = trader; ApplyFilter(); }
    private void ToggleKappa() { kappaOnly = !kappaOnly; ApplyFilter(); }
    private void OnSearchChanged(string value) { search = value ?? ""; ApplyFilter(); }
    private void OnMapFilterChanged(string value) { mapFilter = value ?? ""; ApplyFilter(); }
    private void OnSortChanged(TaskSort value) { sort = value; ApplyFilter(); }

    private void SetMode(RecommendationMode mode)
    {
        recommendationMode = mode;
        recommendations = TaskStateService.GetRecommendations(all, 3, recommendationMode);
    }

    private void SetOverride(TaskView item, QuestOverride kind)
    {
        TaskStateService.SetOverride(item.Task.id, kind);
        Refresh();
    }

    private void ToggleExpanded(string taskId)
    {
        if (!expanded.Remove(taskId))
        {
            expanded.Add(taskId);
        }
    }

    private void ShowOnMap(TaskView item)
    {
        MapsService.RequestHighlight(item);
    }

    private readonly HashSet<string> busyObjectives = new();

    // Objectives are written to Tarkov Tracker; the cached progress follows on
    // success and the page re-renders through ObjectiveProgressChanged.
    private async Task SetObjectiveComplete(TarkovDev.TaskObjective objective, bool complete)
    {
        // Ticking a counted objective also fills its count; unticking keeps the count.
        int? count = objective.count >= 1 && complete ? objective.count : null;
        await WriteObjective(objective, complete, count);
    }

    private async Task ChangeObjectiveCount(TarkovDev.TaskObjective objective, int delta)
    {
        var current = TaskStateService.GetObjectiveProgress(objective.id).Count;
        var next = Math.Clamp(current + delta, 0, objective.count);
        if (next == current)
        {
            return;
        }
        bool? complete = next >= objective.count ? true : (current >= objective.count ? false : null);
        await WriteObjective(objective, complete, next);
    }

    private async Task WriteObjective(TarkovDev.TaskObjective objective, bool? complete, int? count)
    {
        if (!busyObjectives.Add(objective.id))
        {
            return;
        }
        try
        {
            await TaskStateService.SetObjectiveAsync(objective.id, complete, count);
            MapsService.NotifyQuestStateChanged(TimersManager.IsRaidActive || MapsService.RaidActive);
        }
        catch (Exception exception)
        {
            Snackbar.Add(string.Format(LocalizationService.GetString("ObjectiveSyncFailed"), exception.Message), Severity.Warning);
            MessageLog.Diagnostics.Capture(
                new DiagnosticContext("TM-TASKS-002", "SetObjective", "TarkovTracker", "ObjectiveUpdate", "An objective could not be updated on Tarkov Tracker."),
                exception);
        }
        finally
        {
            busyObjectives.Remove(objective.id);
        }
    }

    private void OnObjectiveProgressChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string ViewLabel(TaskListView option) => option switch
    {
        TaskListView.Available => LocalizationService.GetString("TaskStateAvailable"),
        TaskListView.Hidden => LocalizationService.GetString("TaskStateHidden"),
        TaskListView.Completed => LocalizationService.GetString("TaskStateCompleted"),
        _ => LocalizationService.GetString("TaskStateAccepted"),
    };

    private string StateLabel(TaskState state) => state switch
    {
        TaskState.Accepted => LocalizationService.GetString("TaskStateAccepted"),
        TaskState.Available => LocalizationService.GetString("TaskStateAvailable"),
        TaskState.Hidden => LocalizationService.GetString("TaskStateHidden"),
        TaskState.NeverAccepted => LocalizationService.GetString("TaskStateNeverAccepted"),
        TaskState.Completed => LocalizationService.GetString("TaskStateCompleted"),
        _ => state.ToString(),
    };

    private string ReasonLabel(TaskView item) => item.AcceptedReason switch
    {
        "log" => LocalizationService.GetString("AcceptedReasonLog"),
        "progress" => LocalizationService.GetString("AcceptedReasonProgress"),
        "user" => LocalizationService.GetString("AcceptedReasonUser"),
        _ => "",
    };

    private string ModeLabel(RecommendationMode mode) => mode switch
    {
        RecommendationMode.Experience => LocalizationService.GetString("ModeExperience"),
        RecommendationMode.Kappa => LocalizationService.GetString("ModeKappa"),
        RecommendationMode.CurrentMap => string.Format(LocalizationService.GetString("ModeCurrentMap"), currentMap?.name),
        RecommendationMode.Mix => LocalizationService.GetString("ModeMix"),
        _ => LocalizationService.GetString("ModeUnlocks"),
    };

    private string ModeHint(RecommendationMode mode) => mode switch
    {
        RecommendationMode.Experience => LocalizationService.GetString("ModeExperienceHint"),
        RecommendationMode.Kappa => LocalizationService.GetString("ModeKappaHint"),
        RecommendationMode.CurrentMap => LocalizationService.GetString("ModeCurrentMapHint"),
        RecommendationMode.Mix => LocalizationService.GetString("ModeMixHint"),
        _ => LocalizationService.GetString("ModeUnlocksHint"),
    };

    private void OpenTask(TarkovDev.Task task)
    {
        try
        {
            Process.Start(new ProcessStartInfo($"https://tarkov.dev/task/{task.normalizedName}") { UseShellExecute = true });
        }
        catch (Exception exception)
        {
            MessageLog.Diagnostics.Capture(
                new DiagnosticContext("TM-TASKS-001", "OpenTask", "Tasks", "Navigation", "The task page could not be opened in the browser."),
                exception);
        }
    }

    public void Dispose()
    {
        QuestLogStore.Changed -= OnDataChanged;
        MapsService.Changed -= OnDataChanged;
        TimersManager.RaidActiveChanged -= OnDataChanged;
        TarkovDev.ApiDataLoaded -= OnDataChanged;
        TarkovTracker.ProgressRetrieved -= OnProgressRetrieved;
        TarkovTracker.ObjectiveProgressChanged -= OnObjectiveProgressChanged;
        LocalizationService.LanguageChanged -= OnDataChanged;
    }
}

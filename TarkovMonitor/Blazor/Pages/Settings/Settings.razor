@code {
    private static string AppVersion => System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? "";
    private bool checkingForUpdates;

    private async Task CheckForUpdates()
    {
        checkingForUpdates = true;
        StateHasChanged();
        try
        {
            // A newer release announces itself in the messages, where it can be
            // installed. Only the "nothing to do" answer is reported from here.
            if (await WindowHost.CheckForUpdates() == UpdateCheckResult.UpToDate)
            {
                messageLog.AddMessage(string.Format(LocalizationService.GetString("UpToDate"), AppVersion), "update");
            }
        }
        finally
        {
            checkingForUpdates = false;
            StateHasChanged();
        }
    }

    // The date of the current character's latest prestige, not one from an earlier character.
    private DateTime? PrestigeDate => CurrentPrestigeLevel > 0 ? PrestigeRows[^1].Time.Date : null;

    private bool prestigeManualOpen;
    private bool syncingTracker;
    private bool backupBusy;
    private int? logsFolderSessions;
    private DateTime? logsFolderLatest;
    private System.Threading.Timer? relativeTimeRefresh;

    private int NotificationsVolume
    {
        get => Properties.Settings.Default.notificationsVolume;
        set
        {
            Properties.Settings.Default.notificationsVolume = Math.Clamp(value, 0, 100);
            Properties.Settings.Default.Save();
        }
    }

    private string TrackerSyncText => TarkovTracker.LastProgressRetrievedUtc is DateTime synced
        ? string.Format(LocalizationService.GetString("TrackerSynced"), LocalizationService.RelativeTime(synced))
        : LocalizationService.GetString("TrackerNotSynced");

    private async Task SyncTrackerNow()
    {
        syncingTracker = true;
        StateHasChanged();
        try
        {
            await TarkovTracker.GetProgress();
        }
        catch (Exception ex)
        {
            messageLog.AddMessage(string.Format(LocalizationService.GetString("TrackerSyncFailed"), ex.Message), "exception");
        }
        finally
        {
            syncingTracker = false;
            StateHasChanged();
        }
    }

    private void OnTrackerProgressRetrieved(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    /// <summary>Counts the game's session folders, so a wrong logs folder shows up right away.</summary>
    private void RefreshLogsFolderStatus()
    {
        try
        {
            var folder = CustomLogsFolder;
            if (string.IsNullOrWhiteSpace(folder) || !Directory.Exists(folder))
            {
                logsFolderSessions = 0;
                logsFolderLatest = null;
                return;
            }
            var sessions = Directory.GetDirectories(folder, "log_*");
            logsFolderSessions = sessions.Length;
            logsFolderLatest = sessions.Length == 0 ? null : sessions.Max(Directory.GetLastWriteTime);
        }
        catch
        {
            logsFolderSessions = null;
            logsFolderLatest = null;
        }
    }

    private async Task ExportBackup()
    {
        try
        {
            using var dialog = new System.Windows.Forms.SaveFileDialog
            {
                Title = LocalizationService.GetString("ExportBackup"),
                Filter = "Tarkov Monitor backup (*.zip)|*.zip",
                FileName = Backup.DefaultFileName,
                OverwritePrompt = true,
            };
            if (dialog.ShowDialog() != System.Windows.Forms.DialogResult.OK)
            {
                return;
            }
            backupBusy = true;
            StateHasChanged();
            var path = dialog.FileName;
            await Task.Run(() => Backup.Export(path));
            messageLog.AddMessage(string.Format(LocalizationService.GetString("BackupSaved"), path), "info");
        }
        catch (Exception ex)
        {
            messageLog.AddMessage(string.Format(LocalizationService.GetString("BackupFailed"), ex.Message), "exception");
        }
        finally
        {
            backupBusy = false;
            StateHasChanged();
        }
    }

    private async Task RestoreBackup()
    {
        string path;
        using (var dialog = new System.Windows.Forms.OpenFileDialog
        {
            Title = LocalizationService.GetString("RestoreBackup"),
            Filter = "Tarkov Monitor backup (*.zip)|*.zip",
            CheckFileExists = true,
        })
        {
            if (dialog.ShowDialog() != System.Windows.Forms.DialogResult.OK)
            {
                return;
            }
            path = dialog.FileName;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            LocalizationService.GetString("RestoreBackup"),
            LocalizationService.GetString("RestoreBackupConfirm"),
            yesText: LocalizationService.GetString("RestoreAndRestart"),
            cancelText: LocalizationService.GetString("Cancel"));
        if (confirmed != true)
        {
            return;
        }

        try
        {
            backupBusy = true;
            StateHasChanged();
            await Task.Run(() => Backup.Restore(path));
            // A new process picks up the database and settings; this one closes.
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = Environment.ProcessPath ?? Application.ExecutablePath,
                WorkingDirectory = AppContext.BaseDirectory,
                UseShellExecute = false,
            });
            Application.Exit();
        }
        catch (Exception ex)
        {
            backupBusy = false;
            messageLog.AddMessage(string.Format(LocalizationService.GetString("BackupRestoreFailed"), ex.Message), "exception");
            StateHasChanged();
        }
    }

    /// <summary>
    /// The detected runs and prestiges of the current game mode, oldest first.
    /// Prestiges are numbered within their character; a new character starts at zero.
    /// </summary>
    private List<(DateTime Time, int Level)> PrestigeRows
    {
        get
        {
            var rows = new List<(DateTime Time, int Level)>();
            var level = 0;
            foreach (var boundary in HistoryStart.CurrentBoundaries)
            {
                level = boundary.Kind == RunBoundaryKind.Prestige ? level + 1 : 0;
                rows.Add((boundary.Time, level));
            }
            return rows;
        }
    }

    /// <summary>The prestige the current character is in; 0 when there is none.</summary>
    private int CurrentPrestigeLevel => PrestigeRows.Count > 0 ? PrestigeRows[^1].Level : 0;

    private void OnPrestigeDateChanged(DateTime? date)
    {
        if (date == null)
        {
            // Only the latest prestige goes; detected characters and earlier prestiges stay.
            HistoryStart.RemoveLatestPrestige();
            questLogStore.ClearOverrides();
            return;
        }
        if (CurrentPrestigeLevel == 0)
        {
            // The current character has no prestige yet, so this is a new one.
            var mode = HistoryStart.CurrentMode == EftSessionMode.Unknown ? EftSessionMode.PVE : HistoryStart.CurrentMode;
            HistoryStart.AddBoundary(date.Value.Date, RunBoundaryKind.Prestige, mode);
        }
        else
        {
            HistoryStart.ReplaceLatestPrestige(date.Value.Date);
        }
        questLogStore.ClearOverrides();
    }

    private void PrestigeNow()
    {
        var mode = HistoryStart.CurrentMode == EftSessionMode.Unknown ? EftSessionMode.PVE : HistoryStart.CurrentMode;
        HistoryStart.AddBoundary(DateTime.Now, RunBoundaryKind.Prestige, mode);
        questLogStore.ClearOverrides();
    }

    private DateTime? HistoryStartDate => HistoryStart.Value?.Date;

    private void OnHistoryStartChanged(DateTime? date)
    {
        HistoryStart.Set(date?.Date);
    }

    private void ClearData()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        DialogService.ShowAsync<ConfirmClearDataDialog>(LocalizationService.GetString("ClearData"), options);
    }

    [CascadingParameter(Name="AppLayout")]
    public AppLayout AppLayout { get; set; }

    private Dictionary<int, string> PlaybackDevices;
    private List<(string Code, string Name)> AvailableLanguages = new();
    private string resolvedCustomLogsFolder = "";
    private bool BoundKeyFilterEnabled => false;
    private string boundKeyFilter = "";
    // Drawer state survives navigation within this process, but is never persisted.
    private static bool pendingDrawerExpanded;
    private static bool boundDrawerExpanded;
    private static readonly HashSet<string> expandedAccountIds = new(StringComparer.Ordinal);

    private sealed record OrgAccountGroup(
        string AccountId,
        string Nickname,
        List<TarkovTracker.OrgKeySummary> Keys);
    private TarkovDev.Trader? TraderFence
    {
        get
        {
            return TarkovDev.Traders.Find(t => t.normalizedName == "fence");
        }
    }

    private string currentProfileName = GameWatcher.CurrentProfile.HasTarkovDevPlayerRoute
        ? GameWatcher.CurrentProfile.AccountId
        : "";
    private string CurrentProfileName {
        get
        {
            return currentProfileName;
        }
    }

    private RenderFragment TarkovDevWebsiteRemoteTitle => builder =>
    {
        var sequence = 0;
        var title = LocalizationService.GetString("TarkovDevWebsiteRemote");
        const string linkText = "Tarkov.dev";
        var linkStart = title.IndexOf(linkText, StringComparison.OrdinalIgnoreCase);
        if (linkStart < 0)
        {
            builder.AddContent(sequence++, title);
            return;
        }

        builder.AddContent(sequence++, title[..linkStart]);
        builder.OpenElement(sequence++, "a");
        builder.AddAttribute(sequence++, "href", "https://tarkov.dev");
        builder.AddAttribute(sequence++, "target", "_blank");
        builder.AddAttribute(sequence++, "rel", "noopener noreferrer");
        builder.AddAttribute(sequence++, "class", "tm-section-link");
        builder.AddContent(sequence++, title.Substring(linkStart, linkText.Length));
        builder.CloseElement();
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "tm-section-suffix");
        builder.AddContent(sequence++, title[(linkStart + linkText.Length)..].TrimStart());
        builder.CloseElement();
    };
    private static string GetProfileTypeDisplayName(ProfileType profileType) => profileType switch
    {
        ProfileType.PVE => "PVE",
        ProfileType.Regular => "PVP",
        ProfileType.PvpSeason => "Seasonal PVP",
        _ => profileType.ToString(),
    };

    private async Task UpdateProfileName()
    {
        // Also the profile remembered for the chosen mode while the game is closed.
        var profile = GameWatcher.CurrentProfile.Snapshot();
        if (!profile.HasTarkovDevPlayerRoute)
        {
            currentProfileName = "";
            return;
        }

        currentProfileName = profile.AccountId;
        var profileName = await TarkovDev.GetPlayerName(profile);
        if (GameWatcher.CurrentProfile.HasTarkovDevPlayerRoute
            && string.Equals(GameWatcher.CurrentProfile.AccountId, profile.AccountId, StringComparison.Ordinal)
            && string.Equals(GameWatcher.CurrentProfile.Id, profile.Id, StringComparison.Ordinal)
            && GameWatcher.CurrentProfile.SessionMode == profile.SessionMode)
        {
            currentProfileName = profileName;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        PlaybackDevices = Sound.GetPlaybackDevices();
        AvailableLanguages = LocalizationService.GetAvailableLanguages();
        LocalizationService.LanguageChanged += OnLanguageChanged;
        ResolveCustomLogsFolder();
        eft.GameStarted += OnGameClientStateChanged;
        eft.GameStopped += OnGameClientStateChanged;
        eft.ProfileChanged += OnGameClientStateChanged;
        TarkovTracker.ProgressRetrieved += OnTrackerProgressRetrieved;
        RefreshLogsFolderStatus();
        // Relative times ("5 min ago") would otherwise only change on the next render.
        relativeTimeRefresh = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 60000, 60000);
        _ = UpdateProfileName();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (firstRender)
        {
            AppLayout.SetTitle(LocalizationService.GetString("Settings"));
        }
    }

    public void Dispose()
    {
        LocalizationService.LanguageChanged -= OnLanguageChanged;
        eft.GameStarted -= OnGameClientStateChanged;
        eft.GameStopped -= OnGameClientStateChanged;
        eft.ProfileChanged -= OnGameClientStateChanged;
        TarkovTracker.ProgressRetrieved -= OnTrackerProgressRetrieved;
        relativeTimeRefresh?.Dispose();
    }

    private void OnGameClientStateChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await UpdateProfileName();
            StateHasChanged();
        });
    }


@page "/settings"
@using System.Diagnostics
@using NAudio.Wave
@using System.Text.RegularExpressions;
@inject GameWatcher eft
@inject MessageLog messageLog
@inject IDialogService DialogService
@inject LocalizationService LocalizationService
@inject TimersManager timersManager
@inject MainBlazorUI WindowHost
@inject QuestLogStore questLogStore
@layout AppLayout
@implements IDisposable

<MudGrid Class="settings-grid pa-0" Spacing="0">
    <MudItem xs="12" lg="6" xl="4">
        <MudPaper Class="app-surface pa-2 ma-2 mx-4" Elevation="3">
            <MudText Typo="Typo.h6" Class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2"/><span class="tm-card-heading-text">@LocalizationService.GetString("General")</span></MudText>
            <div class="tm-field tm-field--wide mt-2">
                <span class="tm-field__caption">@LocalizationService.GetString("Language")</span>
                <MudSelect @bind-Value="@SelectedLanguage" T="string" Variant="Variant.Text" Underline="false" Margin="Margin.None" Dense="true" RelativeWidth="DropdownWidth.Adaptive" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" PopoverFixed="false" Modal="false" MaxHeight="280" Class="tm-field__control" PopoverClass="tm-select-popover" ListClass="tm-select-list">
                    @foreach (var language in AvailableLanguages)
                    {
                        <MudSelectItem T="string" Value="@language.Code">@language.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            @* Date and time formats for every date the app shows; "Language" keeps the language's own. *@
            <div class="tm-field-pair mt-2">
                <div class="tm-field">
                    <span class="tm-field__caption">@LocalizationService.GetString("FieldDate")</span>
                    <MudSelect @bind-Value="@DateFormatSelect" T="string" Variant="Variant.Text" Underline="false" Margin="Margin.None" Dense="true" RelativeWidth="DropdownWidth.Adaptive" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" PopoverFixed="false" Modal="false" MaxHeight="280" Class="tm-field__control" PopoverClass="tm-select-popover" ListClass="tm-select-list">
                        <MudSelectItem T="string" Value="@string.Empty">@LocalizationService.GetString("FormatLanguage")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("dmy")">31.12.2026</MudSelectItem>
                        <MudSelectItem T="string" Value="@("mdy")">12/31/2026</MudSelectItem>
                        <MudSelectItem T="string" Value="@("ymd")">2026-12-31</MudSelectItem>
                    </MudSelect>
                </div>
                <div class="tm-field">
                    <span class="tm-field__caption">@LocalizationService.GetString("FieldClock")</span>
                    <MudSelect @bind-Value="@TimeFormatSelect" T="string" Variant="Variant.Text" Underline="false" Margin="Margin.None" Dense="true" RelativeWidth="DropdownWidth.Adaptive" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" PopoverFixed="false" Modal="false" MaxHeight="280" Class="tm-field__control" PopoverClass="tm-select-popover" ListClass="tm-select-list">
                        <MudSelectItem T="string" Value="@string.Empty">@LocalizationService.GetString("FormatLanguage")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("24")">24 h (13:45)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("12")">12 h (1:45 PM)</MudSelectItem>
                    </MudSelect>
                </div>
            </div>
            <div class="tm-settings-section">@LocalizationService.GetString("WindowBehavior")</div>
            <MudSwitch @bind-Value="@MinimizeAtStartupSwitch" Label="@LocalizationService.GetString("StartTarkovMonitorMinimized")" Color="Color.Info" />
            <MudSwitch @bind-Value="@MinimizeToTraySwitch" Label="@LocalizationService.GetString("MinimizeToSystemTray")" Color="Color.Info" />
            <MudSwitch @bind-Value="@StayOnTopSwitch" Label="@LocalizationService.GetString("StayOnTop")" Color="Color.Info" />
            <MudSwitch @bind-Value="@SkipSplashSwitch" Label="@LocalizationService.GetString("SkipTarkovDevSplashLogo")" Color="Color.Info" />
            <div class="tm-settings-section">@LocalizationService.GetString("Updates")</div>
            <div class="tm-settings-inline">
                <span>Tarkov Monitor <b>@AppVersion</b></span>
                <MudLink Href="https://github.com/Scholle1309/TarkovMonitor/releases" Target="_blank" Typo="Typo.body2">@LocalizationService.GetString("Releases")</MudLink>
            </div>
            <MudButton OnClick="CheckForUpdates" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Update" Disabled="@checkingForUpdates" Class="mt-2 mb-1">@LocalizationService.GetString("CheckForUpdates")</MudButton>
            <div class="tm-settings-section">@LocalizationService.GetString("Backup")</div>
            <div class="tm-settings-inline">
                <MudButton OnClick="ExportBackup" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.SaveAlt" Disabled="@backupBusy">@LocalizationService.GetString("ExportBackup")</MudButton>
                <MudButton OnClick="RestoreBackup" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.SettingsBackupRestore" Disabled="@backupBusy">@LocalizationService.GetString("RestoreBackup")</MudButton>
            </div>
            <MudText Typo="Typo.caption" Class="tm-settings-hint">@LocalizationService.GetString("BackupHint")</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="6" xl="4">
        <MudPaper Class="app-surface pa-2 ma-2 mx-4" Elevation="3">
            <MudText Typo="Typo.h6" Class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Notifications" Class="mr-2" /><span class="tm-card-heading-text">@LocalizationService.GetString("AlertsAndTimers")</span></MudText>
            @* Device, volume, run-through time and Scav karma share one field style:
               same height and frame, the caption inside on the left. *@
            <div class="tm-field tm-field--wide mt-2">
                <span class="tm-field__caption">@LocalizationService.GetString("FieldDevice")</span>
                <MudSelect @bind-Value="@AudioOutputDeviceSelect" T="int" Variant="Variant.Text" Underline="false" Margin="Margin.None" Dense="true" RelativeWidth="DropdownWidth.Adaptive" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" PopoverFixed="false" Modal="false" MaxHeight="280" Class="tm-field__control" PopoverClass="tm-select-popover" ListClass="tm-select-list">
                    @foreach (var device in PlaybackDevices)
                    {
                        <MudSelectItem T="int" Value="@device.Key">@device.Value</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="tm-field tm-field--wide mt-2">
                <span class="tm-field__caption">@LocalizationService.GetString("Volume")</span>
                <MudIcon Icon="@(NotificationsVolume == 0 ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)" Size="Size.Small" Class="tm-field__icon" />
                <MudSlider T="int" @bind-Value="@NotificationsVolume" Min="0" Max="100" Step="5" Immediate="true" Color="Color.Info" Class="tm-field__slider" aria-label="@LocalizationService.GetString("Volume")" />
                <span class="tm-field__value">@NotificationsVolume %</span>
            </div>
            <div class="tm-settings-section">@LocalizationService.GetString("Raid")</div>
            <div class="tm-alert-row">
                <MudIconButton Icon="@Icons.Material.Filled.Audiotrack" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" OnClick="PlayRaidStart" aria-label="@LocalizationService.GetString("PlaySound")" Class="tm-alert-play" />
                <MudSwitch @bind-Value="@RaidStartSwitch" Label="@LocalizationService.GetString("RaidStartingAudioNotification")" Color="Color.Info" Class="tm-alert-switch" />
            </div>
            <div class="tm-alert-row">
                <MudIconButton Icon="@Icons.Material.Filled.Audiotrack" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" OnClick="PlayMatchFound" aria-label="@LocalizationService.GetString("PlaySound")" Class="tm-alert-play" />
                <MudSwitch @bind-Value="@MatchFoundSwitch" Label="@LocalizationService.GetString("MatchFoundAudioNotification")" Color="Color.Info" Class="tm-alert-switch" />
            </div>
            <div class="tm-alert-row">
                <MudIconButton Icon="@Icons.Material.Filled.Audiotrack" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" OnClick="PlayRunthrough" aria-label="@LocalizationService.GetString("PlaySound")" Class="tm-alert-play" />
                <MudSwitch @bind-Value="@RunthroughSwitch" Label="@LocalizationService.GetString("RunthroughPeriodAudioReminder")" Color="Color.Info" Class="tm-alert-switch" />
                <div class="tm-field tm-alert-extra">
                    <span class="tm-field__caption">@LocalizationService.GetString("FieldTime")</span>
                    <MudTextField @bind-Value="@RunthroughTime" Variant="Variant.Text" Underline="false" Margin="Margin.None" Placeholder="HH:MM:SS" Class="tm-field__control" />
                </div>
            </div>
            <div class="tm-settings-section">@LocalizationService.GetString("Reminders")</div>
            <div class="tm-alert-row">
                <MudIconButton Icon="@Icons.Material.Filled.Audiotrack" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" OnClick="PlayRestartTask" aria-label="@LocalizationService.GetString("PlaySound")" Class="tm-alert-play" />
                <MudSwitch @bind-Value="@RestartTaskSwitch" Label="@LocalizationService.GetString("RestartTasksAudioReminder")" Color="Color.Info" Class="tm-alert-switch" />
            </div>
            <div class="tm-alert-row">
                <MudIconButton Icon="@Icons.Material.Filled.Audiotrack" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" OnClick="PlayAirFilters" aria-label="@LocalizationService.GetString("PlaySound")" Class="tm-alert-play" />
                <MudSwitch @bind-Value="@AirFilterSwitch" Label="@LocalizationService.GetString("AirFilterAudioReminders")" Color="Color.Info" Class="tm-alert-switch" />
            </div>
            <div class="tm-alert-row">
                <MudIconButton Icon="@Icons.Material.Filled.Audiotrack" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" OnClick="PlayQuestItems" aria-label="@LocalizationService.GetString("PlaySound")" Class="tm-alert-play" />
                <MudSwitch @bind-Value="@QuestItemsSwitch" Label="@LocalizationService.GetString("QuestItemReminderAudioNotification")" Color="Color.Info" Class="tm-alert-switch" />
            </div>
            <div class="tm-alert-row">
                <MudIconButton Icon="@Icons.Material.Filled.Audiotrack" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" OnClick="PlayScavAvailable" aria-label="@LocalizationService.GetString("PlaySound")" Class="tm-alert-play" />
                <MudSwitch @bind-Value="@ScavCooldownSwitch" Label="@LocalizationService.GetString("ScavCooldownReminders")" Color="Color.Info" Class="tm-alert-switch" />
                <div class="tm-field tm-alert-extra" title="@LocalizationService.GetString("ScavKarma")">
                    <span class="tm-field__caption">@LocalizationService.GetString("FieldKarma")</span>
                    <MudSelect @bind-Value="@ScavKarmaSelect" T="int" Variant="Variant.Text" Underline="false" Margin="Margin.None" Dense="true" RelativeWidth="DropdownWidth.Adaptive" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" PopoverFixed="false" Modal="false" MaxHeight="280" Class="tm-field__control" PopoverClass="tm-select-popover" ListClass="tm-select-list">
                        @if (TraderFence != null)
                        {
                            @foreach (TarkovDev.TraderReputationLevel lvl in TraderFence.reputationLevels)
                            {
                                <MudSelectItem Value="@lvl.minimumReputation" />
                            }
                        }
                    </MudSelect>
                </div>
            </div>
            <div class="tm-settings-section">@LocalizationService.GetString("FloatingTimer")</div>
            <MudSwitch @bind-Value="@FloatingTimerPanelSwitch" Label="@LocalizationService.GetString("FloatingTimerShow")" Color="Color.Info" />
            <div class="tm-settings-inline ml-2">
                <MudCheckBox @bind-Value="@FloatingTimerShowTimeInRaidSwitch" Label="@LocalizationService.GetString("FloatingTimerRaidTime")" Color="Color.Info" Dense="true" Disabled="@(!FloatingTimerPanelSwitch)" />
                <MudCheckBox @bind-Value="@FloatingTimerShowRunThroughSwitch" Label="@LocalizationService.GetString("FloatingTimerRunthrough")" Color="Color.Info" Dense="true" Disabled="@(!FloatingTimerPanelSwitch)" />
            </div>
            <MudText Typo="Typo.caption" Class="tm-settings-hint">@LocalizationService.GetString("FloatingTimerHint")</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="6" xl="4">
        <MudPaper id="tarkov-tracker" Class="app-surface pa-2 ma-2 mx-4" Elevation="3">
            <MudText Typo="Typo.h6" Class="d-flex align-center"><MudIcon Icon="@trackerIcon" Class="mr-2"/><span class="tm-card-heading-text">@LocalizationService.GetString("TarkovTracker")</span></MudText>
            <div class="tm-field tm-field--wide mt-2" title="@LocalizationService.GetString("TarkovTrackerServiceHelperText")">
                <span class="tm-field__caption">@LocalizationService.GetString("FieldService")</span>
                <MudSelect @bind-Value="@TarkovTrackerDomain" T="string" Variant="Variant.Text" Underline="false" Margin="Margin.None" Dense="true" RelativeWidth="DropdownWidth.Adaptive" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" PopoverFixed="false" Modal="false" MaxHeight="280" Class="tm-field__control" PopoverClass="tm-select-popover" ListClass="tm-select-list">
                    @foreach (var pair in TarkovTracker.Domains)
                    {
                        <MudSelectItem T="string" Value="@pair.Key">@pair.Value</MudSelectItem>
                    }
                </MudSelect>
            </div>
            @if (IsRetiredTrackerService)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    Support for TarkovTracker.io has been retired. Switch to <MudLink Href="https://tarkovtracker.org/settings/" Target="_blank">TarkovTracker.org</MudLink> for continued support.
                </MudAlert>
            }
            @if (!IsRetiredTrackerService)
            {
                @* Status as label/value rows; the actions sit together in the toolbar below. *@
                <div class="tracker-status">
                    <span class="tracker-status__label">@LocalizationService.GetString("CurrentProfile")</span>
                    <span class="tracker-status__value">
                        @if (HasCurrentProfileRoute)
                        {
                            <MudLink Href="@CurrentProfileUrl" Class="tm-profile-link">@CurrentProfileName (@GetProfileTypeDisplayName(GameWatcher.CurrentProfile.Type))</MudLink>
                        }
                        else
                        {
                            <span>No EFT profile detected.</span>
                        }
                    </span>
                    <span class="tracker-status__label">@LocalizationService.GetString("Progress")</span>
                    <span class="tracker-status__value">@TrackerSyncText</span>
                    @* The sync button spans both rows, centred on the right. *@
                    <MudTooltip Text="@LocalizationService.GetString("SyncNow")" RootClass="tracker-status__sync">
                        <MudIconButton Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Color="Color.Info" OnClick="SyncTrackerNow" Disabled="@syncingTracker" aria-label="@LocalizationService.GetString("SyncNow")" Class="tracker-status__action" />
                    </MudTooltip>
                </div>
                @foreach (var warning in TrackerStorageWarnings)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@warning</MudAlert>
                }
                <div class="tracker-key-toolbar">
                    @if (CanImportOrgKey)
                    {
                        <MudButton @onclick="OpenImportTrackerKey" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" Class="tracker-toolbar-button">Import API Token</MudButton>
                    }
                    else
                    {
                        <MudTooltip Text="@OrgImportBlockedReason">
                            <span><MudButton Disabled="true" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" Class="tracker-toolbar-button">Import API Token</MudButton></span>
                        </MudTooltip>
                    }
                    <MudButton @onclick="OpenTrackerSettings" Variant="Variant.Text" Color="Color.Info" StartIcon="@Icons.Material.Filled.OpenInNew" Class="tracker-toolbar-button">@LocalizationService.GetString("GetAToken")</MudButton>
                </div>

                <div class="tracker-key-manager">
                    <div class="tracker-state-note tracker-manager-warning" role="note">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" Class="tracker-state-note-icon" />
                        <span><b>Tokens are managed automatically.</b> Only change an assignment if you know how EFT profiles and game modes are linked.</span>
                    </div>

                    <div class="tracker-drawer mb-1">
                        <button type="button" class="tracker-drawer-toggle tracker-drawer-toggle--primary" @onclick="TogglePendingDrawer" aria-expanded="@pendingDrawerExpanded.ToString().ToLowerInvariant()">
                            <MudIcon Icon="@(pendingDrawerExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="tracker-chevron" />
                            <span class="tracker-drawer-title">Unassigned</span>
                            <span class="tracker-count-badge">@PendingOrgKeys.Count</span>
                        </button>
                        <MudCollapse Expanded="@pendingDrawerExpanded">
                            <div class="tracker-drawer-content">
                                <div class="tracker-state-note" role="note">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="tracker-state-note-icon" />
                                    <span><b>Verified, not assigned yet.</b> A key is assigned to the first matching EFT profile and mode seen. Use Assign if several keys fit or you unassigned one on purpose.</span>
                                </div>
                                @if (PendingOrgKeys.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="tracker-empty-state">No unassigned API token is stored.</MudText>
                                }
                                @foreach (var key in PendingOrgKeys)
                                {
                                    <div class="tracker-pending-card">
                                        <div class="tracker-key-main">
                                            <div class="tracker-key-copy">
                                                <div class="d-flex align-center flex-wrap gap-2">
                                                    <span class="tracker-mode-badge @ModeBadgeClass(key)">@key.DisplayName</span>
                                                    <MudText Typo="Typo.body2"><b>Not assigned</b></MudText>
                                                    <span class="tracker-verification-badge @(key.IsVerified ? "tracker-verification-badge--verified" : "tracker-verification-badge--pending")">
                                                        @(key.IsVerified ? "Verified" : "Verify on assign")
                                                    </span>
                                                    @if (key.IsAutoBindBlocked)
                                                    {
                                                        <span class="tracker-assignment-badge tracker-assignment-badge--manual" title="Automatic assignment is blocked for the account that previously owned this key.">
                                                            MANUAL ASSIGNMENT ONLY
                                                        </span>
                                                    }
                                                </div>
                                                <MudText Typo="Typo.caption" Class="tracker-token">@key.MaskedToken</MudText>
                                                @if (key.IsLegacyRecovery)
                                                {
                                                    <MudText Typo="Typo.caption">Previously saved TarkovTracker.org key</MudText>
                                                }
                                            </div>
                                            <div class="tracker-key-actions">
                                                @if (!OrgKeyChangesEnabled || key.IsQuarantined)
                                                {
                                                    <MudTooltip Text="@PendingAssignBlockedReason(key)">
                                                        <span><MudButton Disabled="true" Variant="Variant.Text" Size="Size.Small">Assign</MudButton></span>
                                                    </MudTooltip>
                                                }
                                                else
                                                {
                                                    <MudButton @onclick="@(async () => await OpenAssignOrgKey(key, false))" Variant="Variant.Text" Color="Color.Info" Size="Size.Small">Assign</MudButton>
                                                }
                                                @if (OrgKeyChangesEnabled)
                                                {
                                                    <MudButton @onclick="@(async () => await RemoveOrgKey(key))" Variant="Variant.Text" Color="Color.Error" Size="Size.Small">Remove</MudButton>
                                                }
                                                else
                                                {
                                                    <MudTooltip Text="@OrgKeyChangesBlockedReason">
                                                        <span><MudButton Disabled="true" Variant="Variant.Text" Size="Size.Small">Remove</MudButton></span>
                                                    </MudTooltip>
                                                }
                                            </div>
                                        </div>
                                        @if (key.IsAutoBindBlocked || key.HasPendingConflict || key.IsQuarantined)
                                        {
                                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@PendingKeyIssue(key)</MudAlert>
                                        }
                                    </div>
                                }
                            </div>
                        </MudCollapse>
                    </div>

                    <div class="tracker-drawer">
                        <button type="button" class="tracker-drawer-toggle tracker-drawer-toggle--primary" @onclick="ToggleBoundDrawer" aria-expanded="@boundDrawerExpanded.ToString().ToLowerInvariant()">
                            <MudIcon Icon="@(boundDrawerExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="tracker-chevron" />
                            <span class="tracker-drawer-title">Assigned</span>
                            <span class="tracker-count-badge">@BoundOrgKeys.Count</span>
                        </button>
                        <MudCollapse Expanded="@boundDrawerExpanded">
                            <div class="tracker-drawer-content">
                                <div class="tracker-state-note" role="note">
                                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" Class="tracker-state-note-icon tracker-state-note-icon--bound" />
                                    <span><b>Verified and assigned.</b> Nothing to do: the key of your active profile and mode is used. Wrong account? Edit, then Reassign. Nicknames are optional.</span>
                                </div>
                                @if (BoundOrgKeys.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="tracker-empty-state">No TarkovTracker.org API tokens are assigned.</MudText>
                                }
                                else
                                {
                                    @if (BoundKeyFilterEnabled)
                                    {
                                        <div class="tm-field tm-field--wide tracker-filter">
                                            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="tm-field__icon" />
                                            <MudTextField @bind-Value="boundKeyFilter" Immediate="true" Placeholder="Filter by nickname or Account ID" Variant="Variant.Text" Underline="false" Margin="Margin.None" Class="tm-field__control" />
                                        </div>
                                    }
                                    <div class="tracker-account-list">
                                        @if (BoundOrgKeyGroups.Count == 0)
                                        {
                                            <MudText Typo="Typo.body2" Class="tracker-empty-state">No accounts match this filter.</MudText>
                                        }
                                        @foreach (var accountGroup in BoundOrgKeyGroups)
                                        {
                                            <div class="tracker-account-drawer mb-1">
                                                <div class="tracker-account-heading">
                                                    <button type="button" class="tracker-account-toggle" @onclick="@(() => ToggleAccountDrawer(accountGroup.AccountId))" aria-expanded="@IsAccountDrawerExpanded(accountGroup.AccountId).ToString().ToLowerInvariant()">
                                                        <MudIcon Icon="@(IsAccountDrawerExpanded(accountGroup.AccountId) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="tracker-chevron" />
                                                        <span class="tracker-account-copy">
                                                            <span class="tracker-account-title">@AccountDrawerTitle(accountGroup)</span>
                                                            <span class="tracker-account-subtitle">Account ID: @accountGroup.AccountId @CurrentAccountMarker(accountGroup.AccountId)</span>
                                                        </span>
                                                    </button>
                                                    <span class="tracker-mode-summary">
                                                        @foreach (var key in accountGroup.Keys.OrderBy(key => key.DisplayName, StringComparer.Ordinal))
                                                        {
                                                            <span class="tracker-mode-badge @ModeBadgeClass(key)" title="@key.DisplayName" aria-label="@key.DisplayName">@ModeBadgeShortLabel(key)</span>
                                                        }
                                                    </span>
                                                    <div class="tracker-account-actions">
                                                        <span class="tracker-account-action-slot">
                                                            <MudButton @onclick="@(async () => await ShowOrgAccountDetails(accountGroup))" Variant="Variant.Text" Size="Size.Small">Details</MudButton>
                                                        </span>
                                                        <span class="tracker-account-action-slot">
                                                            @if (OrgKeyChangesEnabled && CanSetAccountNickname(accountGroup))
                                                            {
                                                                <MudButton @onclick="@(async () => await SetOrgAccountNickname(accountGroup))" Variant="Variant.Text" Color="Color.Info" Size="Size.Small">@AccountNicknameAction(accountGroup)</MudButton>
                                                            }
                                                            else
                                                            {
                                                                <MudTooltip Text="@AccountNicknameBlockedReason(accountGroup)">
                                                                    <span><MudButton Disabled="true" Variant="Variant.Text" Size="Size.Small">@AccountNicknameAction(accountGroup)</MudButton></span>
                                                                </MudTooltip>
                                                            }
                                                        </span>
                                                    </div>
                                                </div>
                                                <MudCollapse Expanded="@IsAccountDrawerExpanded(accountGroup.AccountId)">
                                                    <div class="tracker-profile-list">
                                                        @foreach (var key in accountGroup.Keys.OrderBy(key => key.DisplayName, StringComparer.Ordinal))
                                                        {
                                                            <div class="tracker-profile-row">
                                                                <div class="tracker-key-main">
                                                                    <div class="tracker-key-copy">
                                                                        <div class="tracker-profile-identity">
                                                                            <span class="tracker-mode-badge @ModeBadgeClass(key)">@key.DisplayName</span>
                                                                            <MudText Typo="Typo.body2"><b>@ProfileRowLabel(key)</b></MudText>
                                                                            <MudText Typo="Typo.caption" Class="tracker-token">@key.MaskedToken</MudText>
